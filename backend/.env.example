# SafeGuard Backend — Environment Variables
# Copy this file to .env and fill in your values.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./safeguard.db

# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/safeguard

# ── Google Maps / Places ──────────────────────────────────────────────────────
# Required for nearest-services lookup and server-side reverse geocoding.
# Enable: Maps JavaScript API, Geocoding API, Places API
GOOGLE_MAPS_API_KEY=

# ── Twilio (optional) ─────────────────────────────────────────────────────────
# Leave blank to skip Twilio — native device SMS/call intents will be used.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Security ──────────────────────────────────────────────────────────────────
# Shared API key sent by the mobile app in X-API-Key header.
# Ignored when DEBUG=true.
API_KEY=changeme-dev-key

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=true
